# Shared secret. Must be identical on host and agent.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALPHA_TUNNEL_TOKEN=replace-me

# ---- host only ----
ALPHA_HOST_PORT=8787
# Bind to the Tailscale interface rather than 0.0.0.0 when you have one.
ALPHA_HOST_BIND=127.0.0.1

# ---- agent only ----
# Where the host is reachable from the laptop (Tailscale MagicDNS name, tunnel URL, ...).
ALPHA_HOST_URL=http://127.0.0.1:8787
# Defaults to the machine hostname.
ALPHA_AGENT_NAME=
# Comma-separated task types this agent will accept. Empty = every registered handler.
ALPHA_AGENT_CAPABILITIES=
