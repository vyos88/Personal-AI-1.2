# ---------------------------------------------------------------- host only

ALPHA_HOST_PORT=8787
# Comma-separated list of addresses to listen on. Keep 127.0.0.1 so an agent on
# this machine works even when Tailscale is down, and add the tailnet address
# to let other machines reach it. Prefer this over 0.0.0.0, which puts the
# coordinator on every interface including any public one.
#   ALPHA_HOST_BIND=127.0.0.1,100.x.y.z
ALPHA_HOST_BIND=127.0.0.1

# Where users, invites and API keys are persisted. Back this up: losing it
# means losing every credential.
ALPHA_AUTH_STORE=./data/auth.json

# Break-glass credential, full access. It exists only so you can create the
# first admin on a fresh install:
#
#   1. set it, start the host
#   2. npm run admin -- bootstrap-admin --email you@example.com
#   3. redeem the invite it prints
#   4. UNSET THIS and restart — from then on, real keys are the only way in
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALPHA_BOOTSTRAP_TOKEN=

# Base URL used to build the redeem link shown when you create an invite.
# Defaults to the Host header of the request.
ALPHA_INVITE_BASE_URL=

# --------------------------------------------------------------- agent only

# Where the host is reachable from this machine (Tailscale MagicDNS name,
# tunnel URL, LAN address).
ALPHA_HOST_URL=http://127.0.0.1:8787

# This agent's own API key, scoped to agent:connect. Issue one with:
#   npm run admin -- issue-key --user <userId> --scopes agent --name laptop
ALPHA_AGENT_KEY=

# Defaults to the machine hostname.
ALPHA_AGENT_NAME=

# Comma-separated task types this agent will accept. Empty = every registered
# handler.
ALPHA_AGENT_CAPABILITIES=

# RAM this machine keeps for itself, in MB. Everything above it is offered to
# the host, which places memory-hungry tasks by that figure. Lending every last
# free byte is how a laptop ends up swapping, which helps nobody.
ALPHA_AGENT_MEMORY_RESERVE_MB=512

# Opt-in handlers, comma-separated, by module name from src/agent/handlers.
#   memstore            lets the host park data in this machine's RAM by key
#   alpha-coordination  runs Alpha's coordination script (host machine only)
ALPHA_EXTRA_HANDLERS=

# memstore only. Budget for data the host parks here, in MB. Defaults to a
# quarter of this machine's RAM, capped at 1024. The store evicts the least
# recently used entries to stay inside it.
ALPHA_MEMSTORE_LIMIT_MB=

# memstore only. Largest single value, in MB. Defaults to half the budget.
ALPHA_MEMSTORE_MAX_VALUE_MB=

# ----------------------------------------------------------------- admin CLI

# Credential the CLI authenticates with. Usually an admin's API key; on a
# fresh install it falls back to ALPHA_BOOTSTRAP_TOKEN.
ALPHA_ADMIN_TOKEN=

# ---------------------------------------------------------------------- both

# debug | info | warn | error
ALPHA_LOG_LEVEL=info
# Set to "json" for one JSON object per line.
ALPHA_LOG_FORMAT=

# Deprecated: the old single shared secret. Still accepted as a bootstrap
# token and by agents, so existing deployments keep running, but it grants
# full access to everyone holding it and cannot be revoked per-user. Replace
# it with per-agent keys.
ALPHA_TUNNEL_TOKEN=
